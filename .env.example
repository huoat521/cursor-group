PROJECT_NAME=cursor_group
SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_PASSWORD=replace-with-strong-cursor-password
# Compose 把 MySQL 映到宿主机 3307；容器内仍是 3306
ASYNC_MYSQL_URI=mysql+aiomysql://cursor:replace-with-strong-cursor-password@127.0.0.1:3307/cursor_group
SQL_ECHO=false

REDIS_CACHED_URI=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

CURSOR_TOKEN_ENCRYPT_KEY=replace-with-openssl-rand-hex-16
CURSOR_OAUTH_CLIENT_ID=KbZUR41cY7W6zRSdpSUJ7I7mLYBKOCmB

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

AUTH_LOCAL_ENABLED=true
AUTH_LDAP_ENABLED=false
AUTH_OIDC_ENABLED=false
AUTH_AUTO_PROVISION=false
AUTH_AUTO_PROVISION_ROLE=member

LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_FILTER=(uid={username})
LDAP_USE_SSL=false

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oidc/callback
OIDC_SCOPES="openid profile email"
OIDC_FRONTEND_REDIRECT=http://127.0.0.1:5173/login

WEBHOOK_ALERT_URL=
# 开发若用 Vite 5175，请把该 origin 加进来
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175,http://localhost:5175
